Installation Steps for Istio 1.29.2
1. Download Istio 1.29.2
curl -L https://istio.io/downloadIstio | ISTIO_VERSION=1.29.2 sh -

2. ls -la
    cd istio-1.29.2

3. Add istioctl to your PATH
export PATH=$PWD/bin:$PATH


To make this permanent:
echo 'export PATH=$HOME/istio-1.29.2/bin:$PATH' >> ~/.bashrc
source ~/.bashrc

4. Verify istioctl version
istioctl version

istioctl install --set profile=demo -y

kubectl label namespace productpage istio-injection=enabled

kubectl label namespace rating istio.io/dataplane-mode=ambient